# Copy this file to ".env" and fill in your real keys. Never commit ".env" to GitHub.

# Required: get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional but recommended: get a free key in seconds at https://api.data.gov/signup/
# If you skip this, the app falls back to the public rate-limited "DEMO_KEY".
USDA_API_KEY=DEMO_KEY

# Flask session signing key - any random string works
FLASK_SECRET_KEY=change-this-to-any-random-string
